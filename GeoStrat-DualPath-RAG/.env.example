# .env.example — API密钥和配置模板
# 复制此文件为 .env 并填入真实密钥
# .env 文件已在 .gitignore 中排除，不会被提交到版本库

# Google Gemini
GOOGLE_API_KEY=请在这里填入您的Google_API_KEY

# 星火 (SparkAI) V3.5
SPARK_APP_ID_V35=YOUR_SPARK_APP_ID_V35
SPARK_API_KEY_V35=YOUR_SPARK_API_KEY_V35
SPARK_API_SECRET_V35=YOUR_SPARK_API_SECRET_V35

# 星火 (SparkAI) V4.0
SPARK_APP_ID_V40=YOUR_SPARK_APP_ID_V40
SPARK_API_KEY_V40=YOUR_SPARK_API_KEY_V40
SPARK_API_SECRET_V40=YOUR_SPARK_API_SECRET_V40

# 星火 (SparkAI) V3.1
SPARK_APP_ID_V31=YOUR_SPARK_APP_ID_V31
SPARK_API_KEY_V31=YOUR_SPARK_API_KEY_V31
SPARK_API_SECRET_V31=YOUR_SPARK_API_SECRET_V31

# 星火图像理解
SPARK_IMAGE_APPID=YOUR_SPARK_IMAGE_APPID
SPARK_IMAGE_API_KEY=YOUR_SPARK_IMAGE_API_KEY
SPARK_IMAGE_API_SECRET=YOUR_SPARK_IMAGE_API_SECRET

# 百炼 (阿里云 DashScope)
BAILIAN_API_KEY=YOUR_BAILIAN_API_KEY

# 局业务网 AI4X 模型服务
AI4X_QWQ_TOKEN=YOUR_AI4X_QWQ_TOKEN
AI4X_DEEPSEEK_TOKEN=YOUR_AI4X_DEEPSEEK_TOKEN

# MySQL 数据库
MYSQL_USERNAME=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_HOST=localhost
MYSQL_DATABASE=tree
